# SPOTection Camera Configuration
# Copy this file to .env and configure your camera settings

# ============================================
# CAMERA SOURCE TYPE
# ============================================
# Options: 'placeholder', 'webcam', 'http_mjpeg', 'http_snapshot', 'rtsp'
#
# - placeholder: Test placeholder image (no real camera)
# - webcam: Local USB webcam (use 0 for default camera, 1 for second camera, etc.)
# - http_mjpeg: MJPEG stream URL (continuous video stream)
# - http_snapshot: HTTP snapshot URL (fetches single frame on each request)
# - rtsp: RTSP stream (IP cameras, DVRs)

CAMERA_SOURCE=http_snapshot

# ============================================
# CAMERA URL
# ============================================
# The URL or path to your camera source
#
# Examples:
# - For webcam: 0 (default camera) or 1 (second camera)
# - For HTTP snapshot: http://192.168.1.100/snapshot.jpg
# - For MJPEG stream: http://192.168.1.100:8080/video.mjpg
# - For RTSP: rtsp://username:password@192.168.1.100:554/stream
# - For public camera: https://example.com/camera/snapshot.jpg

CAMERA_URL=https://resource6.earthcam.net/v0/object/GtVJZlL4VnwZ3X0VJw8BsaKt465wCMA_ACspS6wYgxexPT5u4kEum-0uKZRnSm3SnJlL_j-pyYnDEWnIWTyt9Q!!.jpg

# ============================================
# CAMERA SETTINGS
# ============================================
# Timeout for camera requests in seconds (default: 10)
CAMERA_TIMEOUT=10

# Maximum number of retry attempts for failed camera requests (default: 3)
CAMERA_MAX_RETRIES=3

# ============================================
# FLASK SETTINGS
# ============================================
# Flask debug mode (True/False)
FLASK_DEBUG=False

# Flask host (default: 0.0.0.0 for all interfaces)
FLASK_HOST=0.0.0.0

# Flask port (default: 5000)
FLASK_PORT=5000

# ============================================
# EXAMPLE CONFIGURATIONS
# ============================================

# Example 1: Local Webcam
# CAMERA_SOURCE=webcam
# CAMERA_URL=0

# Example 2: IP Camera Snapshot
# CAMERA_SOURCE=http_snapshot
# CAMERA_URL=http://192.168.1.100/snapshot.jpg

# Example 3: MJPEG Stream
# CAMERA_SOURCE=http_mjpeg
# CAMERA_URL=http://192.168.1.100:8080/video.mjpg

# Example 4: RTSP Stream (IP Camera with authentication)
# CAMERA_SOURCE=rtsp
# CAMERA_URL=rtsp://admin:password123@192.168.1.100:554/stream

# Example 5: Public Camera (EarthCam)
# CAMERA_SOURCE=http_snapshot
# CAMERA_URL=https://example.earthcam.com/camera/snapshot.jpg

# Example 6: Placeholder (for testing without camera)
# CAMERA_SOURCE=placeholder
# CAMERA_URL=

# ============================================
# NOTES
# ============================================
#
# 1. Make sure opencv-python and requests are installed:
#    pip install opencv-python requests
#
# 2. For RTSP streams, ensure your camera firmware supports RTSP
#
# 3. For HTTP sources, make sure the URL is directly accessible
#    (not behind authentication or CORS restrictions)
#
# 4. Test your camera URL first with curl or a web browser:
#    curl -o test.jpg "YOUR_CAMERA_URL"
#
# 5. Some cameras may require specific headers or authentication
#    which would need to be added to camera_manager.py
#
