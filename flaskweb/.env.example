# SPOTection Camera Configuration
# Copy this file to .env and configure your camera settings

# ============================================
# CAMERA SOURCE TYPE
# ============================================
# Options: 'placeholder', 'webcam', 'http_mjpeg', 'http_snapshot', 'rtsp', 'hls', 'webpage'
#
# - placeholder: Test placeholder image (no real camera)
# - webcam: Local USB webcam (use 0 for default camera, 1 for second camera, etc.)
# - http_mjpeg: MJPEG stream URL (continuous video stream)
# - http_snapshot: HTTP snapshot URL (fetches single frame on each request)
# - rtsp: RTSP stream (IP cameras, DVRs)
# - hls: HLS stream (.m3u8 playlist)
# - webpage: Auto-extract video from webpage (YouTube, live streams, etc.)

CAMERA_SOURCE=webpage

# ============================================
# CAMERA URL
# ============================================
# The URL or path to your camera source
#
# Examples:
# - For webcam: 0 (default camera) or 1 (second camera)
# - For HTTP snapshot: http://192.168.1.100/snapshot.jpg
# - For MJPEG stream: http://192.168.1.100:8080/video.mjpg
# - For RTSP: rtsp://username:password@192.168.1.100:554/stream
# - For HLS: https://example.com/stream/playlist.m3u8
# - For webpage: https://taco-about-python.com (extracts video automatically)
# - For public camera: https://example.com/camera/snapshot.jpg

CAMERA_URL=https://taco-about-python.com

# ============================================
# CAMERA SETTINGS
# ============================================
# Timeout for camera requests in seconds (default: 10)
CAMERA_TIMEOUT=10

# Maximum number of retry attempts for failed camera requests (default: 3)
CAMERA_MAX_RETRIES=3

# ============================================
# FLASK SETTINGS
# ============================================
# Flask debug mode (True/False)
FLASK_DEBUG=False

# Flask host (default: 0.0.0.0 for all interfaces)
FLASK_HOST=0.0.0.0

# Flask port (default: 5000)
FLASK_PORT=5000

# ============================================
# EXAMPLE CONFIGURATIONS
# ============================================

# Example 1: Webpage with Auto-Extraction (taco-about-python livestream)
# CAMERA_SOURCE=webpage
# CAMERA_URL=https://taco-about-python.com

# Example 2: Webpage with YouTube Embed
# CAMERA_SOURCE=webpage
# CAMERA_URL=https://example.com/page-with-youtube-video

# Example 3: HLS Stream (.m3u8)
# CAMERA_SOURCE=hls
# CAMERA_URL=https://example.com/live/stream.m3u8

# Example 4: Local Webcam
# CAMERA_SOURCE=webcam
# CAMERA_URL=0

# Example 5: IP Camera Snapshot
# CAMERA_SOURCE=http_snapshot
# CAMERA_URL=http://192.168.1.100/snapshot.jpg

# Example 6: MJPEG Stream
# CAMERA_SOURCE=http_mjpeg
# CAMERA_URL=http://192.168.1.100:8080/video.mjpg

# Example 7: RTSP Stream (IP Camera with authentication)
# CAMERA_SOURCE=rtsp
# CAMERA_URL=rtsp://admin:password123@192.168.1.100:554/stream

# Example 8: Public Camera (EarthCam)
# CAMERA_SOURCE=http_snapshot
# CAMERA_URL=https://example.earthcam.com/camera/snapshot.jpg

# Example 9: Placeholder (for testing without camera)
# CAMERA_SOURCE=placeholder
# CAMERA_URL=

# ============================================
# NOTES
# ============================================
#
# 1. Make sure all dependencies are installed:
#    pip install -r requirements.txt
#
#    Required: opencv-python, requests, beautifulsoup4 (for webpage extraction)
#
# 2. For webpage extraction (CAMERA_SOURCE=webpage):
#    - The system will automatically extract video/stream URLs from webpages
#    - Supports YouTube embeds, HLS streams, HTML5 video tags, and iframes
#    - Some sites may block extraction (403 errors) - try different URLs
#
# 3. For HLS streams (.m3u8):
#    - OpenCV can handle basic HLS streams
#    - Complex streams may require ffmpeg installed on system
#    - Install: sudo apt-get install ffmpeg (Linux) or brew install ffmpeg (Mac)
#
# 4. For RTSP streams:
#    - Ensure your camera firmware supports RTSP
#    - Some cameras require specific codecs
#
# 5. For HTTP sources:
#    - Make sure the URL is directly accessible
#    - Not behind authentication or CORS restrictions
#    - Test with: curl -o test.jpg "YOUR_CAMERA_URL"
#
# 6. Troubleshooting:
#    - Check logs for extraction/connection errors
#    - Use /api/camera/health endpoint to check camera status
#    - Try different CAMERA_SOURCE types if one doesn't work
#    - For webpage sources, inspect the page source to find direct video URLs
#
